#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_012A30D0 .scope module, "seqCounterTB" "seqCounterTB" 2 3;
 .timescale -12 -12;
v012AE7A8_0 .var "clk", 0 0;
v012AE800_0 .net "count", 1 0, v012A47B0_0; 1 drivers
v012AE858_0 .var "reset", 0 0;
S_012A46D0 .scope module, "dut" "seqCounter" 2 9, 3 5, S_012A30D0;
 .timescale -9 -12;
v012A4758_0 .net "clk", 0 0, v012AE7A8_0; 1 drivers
v012A47B0_0 .var "count", 1 0;
v012AE750_0 .net "reset", 0 0, v012AE858_0; 1 drivers
E_01141DF0 .event posedge, v012AE750_0, v012A4758_0;
    .scope S_012A46D0;
T_0 ;
    %wait E_01141DF0;
    %load/v 8, v012AE750_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 2, 0;
    %assign/v0 v012A47B0_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v012A47B0_0, 1; Only need 1 of 2 bits
; Save base=8 wid=1 in lookaside.
    %inv 8, 1;
    %ix/load 0, 1, 0;
    %ix/load 1, 0, 0;
    %assign/v0/x1 v012A47B0_0, 0, 8;
    %ix/load 1, 1, 0;
    %mov 4, 0, 1;
    %jmp/1 T_0.2, 4;
    %load/x1p 8, v012A47B0_0, 1;
    %jmp T_0.3;
T_0.2 ;
    %mov 8, 2, 1;
T_0.3 ;
; Save base=8 wid=1 in lookaside.
    %load/v 9, v012A47B0_0, 1; Only need 1 of 2 bits
; Save base=9 wid=1 in lookaside.
    %xor 8, 9, 1;
    %ix/load 0, 1, 0;
    %ix/load 1, 1, 0;
    %assign/v0/x1 v012A47B0_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_012A30D0;
T_1 ;
    %vpi_call 2 16 "$dumpfile", "Seq.vcd";
    %vpi_call 2 17 "$dumpvars", 1'sb0, S_012A30D0;
    %end;
    .thread T_1;
    .scope S_012A30D0;
T_2 ;
    %vpi_call 2 21 "$display", "Counting";
    %vpi_call 2 22 "$monitor", "Time: %0t, reset= %b, count = %d", $time, v012AE858_0, v012AE800_0;
    %set/v v012AE7A8_0, 0, 1;
    %set/v v012AE858_0, 1, 1;
    %delay 10, 0;
    %set/v v012AE858_0, 0, 1;
    %delay 40, 0;
    %set/v v012AE858_0, 1, 1;
    %delay 40, 0;
    %vpi_call 2 31 "$finish";
    %end;
    .thread T_2;
    .scope S_012A30D0;
T_3 ;
    %delay 5, 0;
    %load/v 8, v012AE7A8_0, 1;
    %inv 8, 1;
    %ix/load 0, 1, 0;
    %assign/v0 v012AE7A8_0, 0, 8;
    %jmp T_3;
    .thread T_3;
